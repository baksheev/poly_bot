#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
env_file="${ENV_FILE:-${repo_root}/.env.production}"
start_utc="${1:-}"
end_utc="${2:-}"
namespace="${GKE_NAMESPACE:-arb-bot}"

if [[ ! "${start_utc}" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$ \
  || ! "${end_utc}" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$ ]]; then
  echo "usage: scripts/report-m6-execution-ownership START_UTC END_UTC" >&2
  exit 1
fi
if [[ ! -f "${env_file}" ]]; then
  echo "env file not found: ${env_file}" >&2
  exit 1
fi

set -a
# shellcheck disable=SC1090
source "${env_file}"
set +a
: "${GCP_PROJECT_ID:?GCP_PROJECT_ID is required}"
: "${CLICKHOUSE_URL:?CLICKHOUSE_URL is required}"
: "${CLICKHOUSE_PASSWORD:?CLICKHOUSE_PASSWORD is required}"
clickhouse_user="${CLICKHOUSE_USER:-default}"
clickhouse_database="${CLICKHOUSE_DATABASE:-arb_bot_prod}"
if [[ ! "${clickhouse_database}" =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]]; then
  echo "CLICKHOUSE_DATABASE is not a safe identifier" >&2
  exit 1
fi

startup_filter="resource.type=\"k8s_container\"
AND resource.labels.namespace_name=\"${namespace}\"
AND resource.labels.container_name=\"arb-bot\"
AND jsonPayload.fields.message=\"M6 execution ownership graph validated\"
AND timestamp>=\"${start_utc}\"
AND timestamp<\"${end_utc}\""

echo $'timestamp\tpod\taccount_id\tstrategies\texecutable_symbol\tevm_owners\tjournal_schema\tcandidate_policy\tglobal_serialization'
"${repo_root}/scripts/gcloud-local" logging read "${startup_filter}" \
  --project="${GCP_PROJECT_ID}" \
  --limit=100 \
  --order=asc \
  --format=json \
  | jq -r '
      .[]
      | .jsonPayload.fields as $fields
      | [
          .timestamp,
          .resource.labels.pod_name,
          $fields.account_id,
          $fields.strategy_count,
          $fields.executable_symbol,
          $fields.evm_owner_count,
          $fields.journal_schema_version,
          $fields.candidate_policy,
          $fields.global_trade_serialization
        ]
      | @tsv
    '

query_url="${CLICKHOUSE_URL}?database=${clickhouse_database}&param_start_utc=${start_utc}&param_end_utc=${end_utc}"
echo "query=m6_execution_ownership"
curl --fail --silent --show-error \
  --user "${clickhouse_user}:${CLICKHOUSE_PASSWORD}" \
  --data-binary "@${repo_root}/scripts/sql/m6_execution_ownership.sql" \
  "${query_url}"

"${repo_root}/scripts/report-m5-portfolio-runtime" "${start_utc}" "${end_utc}"
