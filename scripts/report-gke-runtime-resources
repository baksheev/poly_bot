#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
env_file="${ENV_FILE:-${repo_root}/.env.production}"
start_utc="${1:-}"
end_utc="${2:-}"
zone="${GKE_ZONE:-asia-southeast1-b}"
cluster="${GKE_CLUSTER:-arb-bot}"
namespace="${GKE_NAMESPACE:-arb-bot}"

if [[ ! "${start_utc}" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$ \
  || ! "${end_utc}" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$ ]]; then
  echo "usage: scripts/report-gke-runtime-resources START_UTC END_UTC" >&2
  exit 1
fi
if [[ ! -f "${env_file}" ]]; then
  echo "env file not found: ${env_file}" >&2
  exit 1
fi

set -a
# shellcheck disable=SC1090
source "${env_file}"
set +a
: "${GCP_PROJECT_ID:?GCP_PROJECT_ID is required}"

monitoring_token="$(./scripts/gcloud-local auth print-access-token)"
monitoring_filter_suffix="resource.type=\"k8s_container\" AND resource.labels.namespace_name=\"${namespace}\" AND resource.labels.container_name=\"arb-bot\""

monitoring_query() {
  local metric_type="$1"
  local aligner="$2"
  curl --fail --silent --show-error \
    --header "Authorization: Bearer ${monitoring_token}" \
    --get \
    --data-urlencode "filter=metric.type=\"${metric_type}\" AND ${monitoring_filter_suffix}" \
    --data-urlencode "interval.startTime=${start_utc}" \
    --data-urlencode "interval.endTime=${end_utc}" \
    --data-urlencode "aggregation.alignmentPeriod=60s" \
    --data-urlencode "aggregation.perSeriesAligner=${aligner}" \
    --data-urlencode "view=FULL" \
    "https://monitoring.googleapis.com/v3/projects/${GCP_PROJECT_ID}/timeSeries"
}

summarize_monitoring() {
  local metric_name="$1"
  jq -r --arg metric "${metric_name}" '
    [
      .timeSeries[]?.points[]?.value
      | (.doubleValue // .int64Value // empty)
      | tonumber
    ] | sort as $values
    | if ($values | length) == 0 then
        [$metric, 0, "null", "null", "null", "null"] | @tsv
      else
        ($values | length) as $n
        | [
            $metric,
            $n,
            $values[((($n - 1) * 0.50) | floor)],
            $values[((($n - 1) * 0.95) | floor)],
            $values[((($n - 1) * 0.99) | floor)],
            $values[-1]
          ] | @tsv
      end
  '
}

echo $'metric\tn\tp50\tp95\tp99\tmax'
monitoring_query "kubernetes.io/container/cpu/core_usage_time" "ALIGN_RATE" \
  | summarize_monitoring "cpu_cores"
monitoring_query "kubernetes.io/container/cpu/limit_utilization" "ALIGN_MAX" \
  | summarize_monitoring "cpu_limit_utilization"
monitoring_query "kubernetes.io/container/memory/used_bytes" "ALIGN_MAX" \
  | summarize_monitoring "memory_used_bytes"
monitoring_query "kubernetes.io/container/memory/page_fault_count" "ALIGN_RATE" \
  | summarize_monitoring "memory_page_faults_per_second"

./scripts/gcloud-local container clusters get-credentials "${cluster}" \
  --zone="${zone}" \
  --project="${GCP_PROJECT_ID}" >/dev/null

echo "cgroup_snapshot"
kubectl exec \
  --namespace="${namespace}" \
  deployment/arb-bot \
  --container=arb-bot \
  -- sh -c '
    for path in /sys/fs/cgroup/cpu.stat /sys/fs/cgroup/memory.current /sys/fs/cgroup/memory.peak /sys/fs/cgroup/memory.events; do
      if [ -r "$path" ]; then
        printf "%s\n" "$path"
        sed -n "1,40p" "$path"
      fi
    done
    if [ -r /proc/1/status ]; then
      printf "%s\n" "/proc/1/status"
      sed -n "/^VmRSS:/p;/^VmHWM:/p;/^Threads:/p;/^voluntary_ctxt_switches:/p;/^nonvoluntary_ctxt_switches:/p" /proc/1/status
    fi
  '
