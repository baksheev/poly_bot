#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
env_file="${ENV_FILE:-${repo_root}/.env.production}"
start_utc="${1:-}"
end_utc="${2:-}"
namespace="${GKE_NAMESPACE:-arb-bot}"

if [[ ! "${start_utc}" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$ \
  || ! "${end_utc}" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$ ]]; then
  echo "usage: scripts/report-m1-domain START_UTC END_UTC" >&2
  exit 1
fi
if [[ ! -f "${env_file}" ]]; then
  echo "env file not found: ${env_file}" >&2
  exit 1
fi

set -a
# shellcheck disable=SC1090
source "${env_file}"
set +a
: "${GCP_PROJECT_ID:?GCP_PROJECT_ID is required}"

filter="resource.type=\"k8s_container\"
AND resource.labels.namespace_name=\"${namespace}\"
AND jsonPayload.fields.message=\"compiled domain graph validated before network startup\"
AND timestamp>=\"${start_utc}\"
AND timestamp<\"${end_utc}\""

echo $'timestamp\tpod\tcontainer\tbundle\tprojection\tfingerprint\tbundle_bytes\tload_validation_us\trss_before_bytes\trss_after_bytes\trss_delta_bytes\taccounts\tinstruments\tnetworks\twallets\tvenue_assets\teconomic_assets\tpools\tstrategies'
"${repo_root}/scripts/gcloud-local" logging read "${filter}" \
  --project="${GCP_PROJECT_ID}" \
  --limit=100 \
  --order=asc \
  --format=json \
  | jq -r '
      .[]
      | .jsonPayload.fields as $fields
      | [
          .timestamp,
          .resource.labels.pod_name,
          .resource.labels.container_name,
          $fields.bundle_id,
          $fields.compatibility_projection_id,
          $fields.domain_config_sha256,
          $fields.compiled_domain_bundle_bytes,
          $fields.compiled_domain_load_validation_us,
          $fields.compiled_domain_rss_before_bytes,
          $fields.compiled_domain_rss_after_bytes,
          $fields.compiled_domain_rss_delta_bytes,
          $fields.account_count,
          $fields.instrument_count,
          $fields.network_count,
          $fields.wallet_count,
          $fields.venue_asset_count,
          $fields.economic_asset_count,
          $fields.pool_count,
          $fields.strategy_count
        ]
      | @tsv
    '
